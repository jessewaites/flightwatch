<% content_for :title, "Credits" %>

<div class="flightwatch-shell credits-shell">
  <header class="topbar">
    <div>
      <p class="eyebrow">FlightWatch credits</p>
      <h1>Jesse Waites</h1>
    </div>

    <div class="topbar-actions">
      <%= link_to "Dashboard", root_path, class: "utility-button" %>
    </div>
  </header>

  <main class="credits-stage" aria-label="Credits">
    <section class="credits-intro">
      <p class="eyebrow">Connect after the demo</p>
      <h2>Jesse Waites</h2>
      <p>
        I built FlightWatch as a multi-agent airspace anomaly detection demo over Boston.
        Scan the code to add me on LinkedIn.
      </p>
      <%= link_to "linkedin.com/in/jessewaites", "https://www.linkedin.com/in/jessewaites/", class: "credits-link" %>
    </section>

    <section class="qr-panel" aria-label="LinkedIn QR code">
      <%= image_tag "jesse-linkedin-qr.svg", alt: "QR code for Jesse Waites on LinkedIn", class: "linkedin-qr" %>
    </section>
  </main>
</div>
