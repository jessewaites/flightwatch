<% content_for :title, "Evals" %>

<% investigator = @benchmark.fetch("investigator_gate", {}) %>
<% detector = @benchmark.fetch("detector_gate", {}) %>
<% with_skill = investigator.fetch("with_skill", {}) %>
<% without_skill = investigator.fetch("without_skill", {}) %>
<% without_worst = without_skill.fetch("worst", {}) %>
<% without_median = without_skill.fetch("median", {}) %>
<% cases = @evals.fetch("cases", []) %>

<div class="flightwatch-shell evals-shell">
  <header class="topbar">
    <%= link_to root_path, class: "brand-home", "aria-label": "Back to dashboard" do %>
      <p class="eyebrow">FlightWatch evals</p>
      <h1>Evals</h1>
    <% end %>

    <div class="topbar-actions">
      <%= link_to "Credits", credits_path, class: "utility-button" %>
      <%= link_to "Dashboard", root_path, class: "utility-button" %>
    </div>
  </header>

  <div data-controller="tabs">
    <nav class="tabs evals-tabs" aria-label="Evals page tabs">
      <button class="tab is-active" type="button" data-tabs-target="tab" data-tab="evals" data-action="tabs#switch">Evals</button>
      <button class="tab" type="button" data-tabs-target="tab" data-tab="tests" data-action="tabs#switch">Tests</button>
    </nav>

    <section class="tab-panel is-active" data-tabs-target="panel" data-tab-panel="evals">
  <main class="evals-page" aria-label="FlightWatch evaluation results">
    <section class="evals-hero" aria-label="Eval summary">
      <div>
        <p class="eyebrow">Demo receipt</p>
        <h2>Skills turn raw flags into calibrated aviation judgments.</h2>
        <p>
          The scored Investigator gate runs the same flag fixtures with and without
          <code>skills/flight-investigation/SKILL.md</code>. The skill-aware arm preserves the procedure:
          explain why a plane was flagged, pull enrichment, and classify benign versus concern versus emergency.
        </p>
      </div>

      <dl class="evals-scoreboard" aria-label="Benchmark score">
        <div>
          <dt>With skill</dt>
          <dd><%= number_to_percentage(with_skill.fetch("accuracy", 0).to_f * 100, precision: 0) %></dd>
          <span><%= with_skill.fetch("passes", 0) %>/<%= with_skill.fetch("total", 0) %> cases pass</span>
        </div>
        <div>
          <dt>No skill</dt>
          <dd><%= number_to_percentage(without_median.fetch("accuracy", 0).to_f * 100, precision: 0) %></dd>
          <span>median baseline, <%= without_worst.fetch("passes", 0) %>/<%= without_worst.fetch("total", 0) %> worst run</span>
        </div>
        <div>
          <dt>Delta</dt>
          <dd>+<%= number_to_percentage(investigator.fetch("delta_accuracy", 0).to_f * 100, precision: 0) %></dd>
          <span>accuracy lift from the procedural skill</span>
        </div>
      </dl>
    </section>

    <section class="evals-grid" aria-label="Eval gates">
      <article class="evals-card">
        <p class="eyebrow">Gate A</p>
        <h3>Detector regression</h3>
        <p>
          Deterministic Ruby rules are checked against planted traffic before the agents run.
          This keeps detection code separate from model judgment.
        </p>
        <dl class="evals-facts">
          <div>
            <dt>Status</dt>
            <dd><%= detector.fetch("status", "unknown") %></dd>
          </div>
          <div>
            <dt>Cases</dt>
            <dd><%= detector.fetch("cases_passed", 0) %>/<%= detector.fetch("cases_total", 0) %></dd>
          </div>
          <div>
            <dt>Mode</dt>
            <dd><%= detector.fetch("detector_mode", "unknown") %></dd>
          </div>
        </dl>
      </article>

      <article class="evals-card">
        <p class="eyebrow">Gate B</p>
        <h3>Investigator skill quality</h3>
        <p>
          Fixture flags with known-correct outcomes are scored twice: once with the investigation skill,
          then repeated as a <code>--no-skill</code> baseline.
        </p>
        <dl class="evals-facts">
          <div>
            <dt>Status</dt>
            <dd><%= investigator.fetch("status", "unknown") %></dd>
          </div>
          <div>
            <dt>Baseline runs</dt>
            <dd><%= investigator.fetch("runs_per_without_skill_case", @evals.fetch("runs_per_without_skill_case", 0)) %></dd>
          </div>
          <div>
            <dt>Skill file</dt>
            <dd><%= investigator.fetch("skill_file_present", false) ? "present" : "missing" %></dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="evals-cases" aria-label="Investigator eval cases">
      <div class="panel-heading">
        <p class="eyebrow">Case receipts</p>
        <h2>With skill vs. no skill</h2>
      </div>

      <div class="evals-case-list">
        <% if cases.any? %>
          <% cases.each do |test_case| %>
            <% no_skill_assessments = test_case.fetch("without_skill_runs", []).map { |run| run.fetch("assessment", "unknown") }.uniq %>
            <article class="evals-case">
              <div class="feed-card-header compact">
                <div>
                  <p class="eyebrow"><%= test_case.dig("input", "flag", "rule").to_s.humanize %></p>
                  <h3><%= test_case.fetch("id").tr("-", " ") %></h3>
                </div>
                <span class="status-pill"><%= test_case.fetch("expected_assessment", "unknown") %></span>
              </div>

              <dl class="evals-comparison">
                <div>
                  <dt>With skill</dt>
                  <dd class="<%= test_case.dig("with_skill", "pass") ? "is-pass" : "is-fail" %>">
                    <%= test_case.dig("with_skill", "assessment") || "unknown" %>
                  </dd>
                </div>
                <div>
                  <dt>No skill</dt>
                  <dd><%= no_skill_assessments.join(", ") %></dd>
                </div>
                <div>
                  <dt>Aircraft</dt>
                  <dd><%= test_case.dig("input", "flag", "icao24") %></dd>
                </div>
              </dl>

              <p><%= test_case.fetch("evidence", "") %></p>
            </article>
          <% end %>
        <% else %>
          <div class="empty-state">No eval cases found. Run <code>ruby evals/run_all.rb</code>.</div>
        <% end %>
      </div>
    </section>
  </main>
    </section>

    <section class="tab-panel" data-tabs-target="panel" data-tab-panel="tests">
  <main class="evals-page" aria-label="FlightWatch test suite">
    <section class="evals-hero" aria-label="Test summary">
      <div>
        <p class="eyebrow">Engineering receipt</p>
        <h2>Full test coverage across every layer of the system.</h2>
        <p class="tests-prose">
          Beyond the scored eval gates, FlightWatch ships a conventional test suite covering the data
          pipeline, enrichment, the skills, and the Rails UI &mdash; plus frozen-contract schema validation.
          Everything below currently passes with zero failures.
        </p>
      </div>

      <dl class="evals-scoreboard" aria-label="Test totals">
        <div>
          <dt>Test runs</dt>
          <dd>43</dd>
          <span>data, enrichment, skills, UI</span>
        </div>
        <div>
          <dt>Assertions</dt>
          <dd>376</dd>
          <span>0 failures, 0 errors</span>
        </div>
        <div>
          <dt>Contracts</dt>
          <dd>PASS</dd>
          <span>all schemas + fixtures valid</span>
        </div>
      </dl>
    </section>

    <section class="evals-cases" aria-label="Test coverage by area">
      <div class="panel-heading">
        <p class="eyebrow">Coverage map</p>
        <h2>What&rsquo;s under test</h2>
      </div>

      <table class="tests-table">
        <thead>
          <tr><th>Area</th><th>What it covers</th><th>Runs</th><th>Status</th></tr>
        </thead>
        <tbody>
          <tr><td>data/</td><td>frame source, replay harness, rolling buffer, OpenSky poller, token manager, normalizer</td><td>26</td><td class="is-pass">PASS</td></tr>
          <tr><td>enrichment/</td><td>METAR + airport lookups, Open-Meteo weather context</td><td>4</td><td class="is-pass">PASS</td></tr>
          <tr><td>skills/flight-anomaly-rules</td><td>deterministic detector rules + watcher smoke test</td><td>8</td><td class="is-pass">PASS</td></tr>
          <tr><td>skills/airspace-situation</td><td>synthesizer clustering self-test</td><td>1</td><td class="is-pass">PASS</td></tr>
          <tr><td>ui/ (Rails)</td><td>dashboard + static-page controllers</td><td>5</td><td class="is-pass">PASS</td></tr>
          <tr><td>contracts/</td><td>frozen JSON schemas validated against fixtures</td><td>&mdash;</td><td class="is-pass">PASS</td></tr>
        </tbody>
      </table>
    </section>

    <section class="evals-grid" aria-label="How to run the tests">
      <article class="evals-card">
        <p class="eyebrow">Run it</p>
        <h3>Reproduce the suite</h3>
        <p>
          Unit and integration tests run per area as minitest scripts; the Rails UI suite runs through
          <code>bin/rails test</code>.
        </p>
        <dl class="evals-facts">
          <div>
            <dt>Data + skills</dt>
            <dd><code>ruby &lt;file&gt;</code></dd>
          </div>
          <div>
            <dt>UI</dt>
            <dd><code>bin/rails test</code></dd>
          </div>
          <div>
            <dt>Contracts</dt>
            <dd><code>ruby contracts/validate.rb</code></dd>
          </div>
        </dl>
      </article>

      <article class="evals-card">
        <p class="eyebrow">Separate from scoring</p>
        <h3>Tests vs. the eval gate</h3>
        <p>
          These tests prove the system runs and stays correct. The <em>scored</em> skill delta lives on the
          Evals tab and is produced by <code>ruby evals/run_all.rb</code>.
        </p>
      </article>
    </section>
  </main>
    </section>
  </div>
</div>
