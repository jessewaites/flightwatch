<% content_for :title, "FlightWatch" %>
<%= turbo_stream_from "anomalies" %>
<%= turbo_stream_from "synthesis" %>

<div
  class="flightwatch-shell"
  data-controller="flightwatch"
  data-flightwatch-frame-value="<%= json_escape(@snapshot[:frame].to_json) %>"
  data-flightwatch-flags-value="<%= json_escape(@snapshot[:flags].to_json) %>"
  data-flightwatch-verdicts-value="<%= json_escape(@snapshot[:verdicts].to_json) %>"
  data-flightwatch-situations-value="<%= json_escape(@snapshot[:situations].to_json) %>"
  data-flightwatch-mode-value="<%= @snapshot[:mode] %>">
  <header class="topbar">
    <%= link_to root_path, class: "brand-home", "aria-label": "Back to dashboard" do %>
      <p class="eyebrow">Boston airspace</p>
      <h1>FlightWatch</h1>
    <% end %>

    <div class="topbar-actions">
      <%= link_to "Evals", evals_path, class: "utility-button" %>
      <%= link_to "Credits", credits_path, class: "utility-button" %>

      <span data-controller="modal">
        <button class="utility-button" type="button" data-action="modal#open">About</button>

        <div class="modal-backdrop" data-modal-target="dialog" data-action="click->modal#closeBackdrop">
          <div class="modal-card" role="dialog" aria-modal="true" aria-label="About FlightWatch">
            <button class="modal-close" type="button" data-action="modal#close" aria-label="Close">&times;</button>
            <h2>About FlightWatch</h2>
            <p>
              This multi-agent architecture uses a file-based workspace to isolate context across three distinct, specialized scopes, ensuring system efficiency and structural clarity. The Watcher provides wide and shallow coverage by constantly scanning telemetry across all planes for known trouble signs using a cheap, local model. When an anomaly is spotted, it writes a flag file that triggers the Investigator, an expensive frontier model that conducts a narrow, deep analysis by enriching the flagged plane with localized context like weather and airport tracks. Concurrently, the Synthesizer tracks all flags over a temporal window to identify emergent, macro-level patterns (such as ground stops) that a single-plane view would miss. This strategic separation ensures that operational costs scale strictly with the number of anomalies detected rather than total traffic volume, while evaluations prove this skill-equipped approach catches complex vulnerabilities that standard baselines overlook.
            </p>
            <p>
              By decoupling these agents through a framework-agnostic delegation bus using structured JSON contracts, the system avoids the &ldquo;context mush&rdquo; of a single-agent architecture and allows for seamless, parallel development. Rather than relying on rigid, in-process frameworks like LangChain, this file-based handoff exposes clean boundaries that make per-agent model routing explicit and highly customizable. Furthermore, the architecture relies on rule-based detection rooted in established aviation conventions rather than statistical training data, eliminating the need for historical corpora.
</p>
          </div>
        </div>
      </span>
      <button class="icon-button" type="button" data-action="flightwatch#toggleDark" title="Toggle dark mode" aria-label="Toggle dark mode">
        <span data-flightwatch-target="themeIcon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="theme-icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </span>
      </button>
      <div class="mode-switch" role="group" aria-label="Traffic source">
        <button type="button" data-flightwatch-target="realtimeButton" data-action="flightwatch#setRealtime">Real-time</button>
        <button type="button" data-flightwatch-target="demoButton" data-action="flightwatch#setDemo">Demo</button>
      </div>
    </div>
  </header>

  <section class="situation-banner <%= @snapshot[:situations].any? ? "is-visible" : "" %>" data-flightwatch-target="banner">
    <% if @snapshot[:situations].first %>
      <strong><%= @snapshot[:situations].first["kind"].to_s.humanize %> at <%= @snapshot[:situations].first["airport"] %></strong>
      <span><%= @snapshot[:situations].first["summary"] %></span>
    <% else %>
      <strong>Situation watch</strong>
      <span>No synthesized situation yet.</span>
    <% end %>
  </section>

  <main class="dashboard-grid">
    <section class="stage" aria-label="Airspace workspace">
      <nav class="tabs" aria-label="Dashboard tabs">
        <button class="tab is-active" type="button" data-tab="map" data-action="flightwatch#switchTab">Map</button>
        <button class="tab" type="button" data-tab="synthesis" data-action="flightwatch#switchTab">Synthesis</button>
        <button class="tab" type="button" data-tab="costs" data-action="flightwatch#switchTab">Costs</button>
      </nav>

      <div class="panels">
        <section class="panel is-active map-panel" data-flightwatch-target="panel" data-panel="map" aria-label="Map">
          <div class="map-canvas" data-flightwatch-target="map"></div>
        </section>

        <section class="panel feed-panel" data-flightwatch-target="panel" data-panel="synthesis" aria-label="Synthesis">
          <div class="panel-heading">
            <div>
              <p class="eyebrow">Synthesizer report</p>
              <h2>Situation synthesis</h2>
            </div>
            <button class="utility-button" type="button" data-flightwatch-target="synthesisButton" data-action="flightwatch#generateSynthesis">Generate</button>
          </div>
          <div id="synthesis-feed" class="feed-list">
            <% if @snapshot[:situations].any? %>
              <%= render partial: "dashboard/situation", collection: @snapshot[:situations], as: :situation %>
            <% else %>
              <div id="synthesis-empty" class="empty-state">No situation has been synthesized for this window.</div>
            <% end %>
          </div>
        </section>

        <section class="panel feed-panel" data-flightwatch-target="panel" data-panel="costs" aria-label="Costs">
          <div class="panel-heading">
            <p class="eyebrow">Model routing</p>
            <h2>Agent costs</h2>
          </div>
          <div class="feed-list">
            <table class="cost-table">
              <thead>
                <tr>
                  <th>Agent</th>
                  <th>Model</th>
                  <th>Tokens</th>
                  <th>$</th>
                  <th>Latency</th>
                </tr>
              </thead>
              <tbody>
                <% @snapshot[:routing].each do |row| %>
                  <tr class="<%= "total-row" if row[:agent] == "TOTAL" %>">
                    <td><%= row[:agent] %></td>
                    <td><%= row[:model] %></td>
                    <td><%= number_with_delimiter(row[:tokens]) %></td>
                    <td><%= row[:cost].zero? ? "$0" : number_to_currency(row[:cost], precision: 3) %></td>
                    <td><%= row[:latency] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </section>

    <aside class="feed-aside" aria-label="Investigated anomalies">
      <div class="panel-heading">
        <p class="eyebrow">Investigator surface</p>
        <h2>Investigated anomalies</h2>
      </div>
      <div id="anomaly-feed" class="feed-list">
        <% if @anomalies.any? %>
          <%= render partial: "dashboard/anomaly", collection: @anomalies, as: :anomaly %>
        <% else %>
          <div id="anomaly-empty" class="empty-state">No flags have landed on the bus.</div>
        <% end %>
      </div>
      <div id="anomaly-pagination" class="feed-pagination">
        <%= render "dashboard/anomaly_load_more", pagy: @anomaly_pagy %>
      </div>
    </aside>
  </main>
</div>
