#!/usr/bin/env bash
#
# FlightWatch — one-command offline demo boot.
# Resets the file bus, then runs all agents + the frame producer against the SAME workspace,
# playing the planted capture on a schedule. No network required (investigator/synthesizer
# run --offline; watcher falls back to deterministic triage if ollama isn't up).
#
#   bin/demo                 # pipeline only (watch workspace/ fill)
#   bin/demo --with-ui       # also boot the Rails dashboard on :3000
#   INTERVAL=1.0 bin/demo    # faster replay (default 1.5s/frame)
#
# Ctrl-C stops everything.

set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
WS="$ROOT/workspace"
INTERVAL="${INTERVAL:-1.5}"
WITH_UI=0
[ "${1:-}" = "--with-ui" ] && WITH_UI=1

echo "FlightWatch — offline demo pipeline"

# 1. reset the runtime bus (keep the dir structure / .gitkeep)
for d in flags verdicts situations tracks observe; do
  mkdir -p "$WS/$d"
  find "$WS/$d" -name '*.json' -delete 2>/dev/null
done
mkdir -p "$WS/control"
echo '{"source":"demo"}' > "$WS/control/mode.json"

# 2. ollama present? -> watcher uses granite4:micro for tier-2 triage; else deterministic fallback
WATCHER_SKILL="--no-skill"
if curl -sf http://localhost:11434/api/tags >/dev/null 2>&1; then
  WATCHER_SKILL=""
  echo "  ollama up   -> watcher tier-2 triage via granite4:micro"
else
  echo "  ollama down -> watcher deterministic tier-2 (run 'ollama serve' for the model-triage story)"
fi

pids=()
cleanup() { echo; echo "stopping pipeline..."; for p in "${pids[@]}"; do kill "$p" 2>/dev/null || true; done; wait 2>/dev/null; }
trap cleanup EXIT INT TERM

# 3. start the consumers FIRST so they're watching before frames land
echo "  starting investigator (offline) + synthesizer (offline) + watcher..."
ruby agents/investigator.rb --workspace "$WS" --offline --poll 0.4 & pids+=($!)
ruby agents/synthesizer.rb  --workspace "$WS" --offline           & pids+=($!)
ruby agents/watcher.rb      --workspace "$WS" --tracks "$WS/tracks" --poll 0.4 $WATCHER_SKILL & pids+=($!)

if [ "$WITH_UI" = 1 ]; then
  echo "  starting Rails dashboard on http://localhost:3000 ..."
  ( cd ui && FLIGHTWATCH_WORKSPACE="$WS" bin/rails server -p 3000 ) & pids+=($!)
fi

# 4. feed frames
sleep 1
echo "  starting frame producer (planted replay, ${INTERVAL}s/frame)"
ruby bin/produce_frames.rb --workspace "$WS" --reset --interval "$INTERVAL" & pids+=($!)

echo "pipeline up — watch workspace/{flags,verdicts,situations} fill. Ctrl-C to stop."
wait
